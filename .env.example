# Copy to .env.local and fill in values. Never commit .env.local.
#
# Teach-me uses Groq as a free-tier placeholder (OpenAI-compatible).
# When funded, swap the /api/explain provider to Anthropic Claude —
# keep the same SYSTEM_PROMPT + parseExplanation schema.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# FastAPI + RDKit chem microservice (local or hosted)
CHEM_SERVICE_URL=http://127.0.0.1:8000

# Optional shared secret: Next.js sends x-scicard-chem-secret to chem-service.
# Set the SAME value on both Vercel and the chem host when chem is public.
CHEM_SERVICE_SECRET=

# Optional: GET /api/health?stats=1&token=... returns usage counters
USAGE_STATS_TOKEN=

# Saved cards. Leave blank on your laptop (JSON files in data/cards/).
# Set this on the host so links survive a restart. Neon’s free Postgres works.
# Example: postgres://user:password@host/neondb?sslmode=require
DATABASE_URL=
