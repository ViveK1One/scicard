# Copy to .env.local and fill in values. Never commit .env.local.
#
# Teach-me uses Groq (OpenAI-compatible). The key stays on the server.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# FastAPI + RDKit chem microservice (local or hosted). No trailing slash.
CHEM_SERVICE_URL=http://127.0.0.1:8000

# Shared secret: Next.js sends x-scicard-chem-secret to chem-service.
# Set the SAME value on Vercel and the chem host when chem is public.
CHEM_SERVICE_SECRET=

# Usage counters: curl -H "Authorization: Bearer <token>" https://HOST/api/health?stats=1
# Do not put the token in the URL.
USAGE_STATS_TOKEN=

# Production card store (Neon Postgres). Required when NODE_ENV=production.
# Local dev can leave this blank and use data/cards/*.json instead.
# Example: postgres://user:password@host/neondb?sslmode=require
DATABASE_URL=

# Production rate limit, Teach me cache, and usage counters (Upstash Redis).
# Required when NODE_ENV=production. Local dev falls back to process memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# German imprint. Required before a public launch in Germany.
# ADDRESS may contain \n for line breaks.
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
IMPRESSUM_EMAIL=
